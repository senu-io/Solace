{
  "name": "solace-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Next-generation Discord music system and dual dashboard",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm --workspace=packages/shared run build && npm --workspace=packages/database run build && npm --workspace=apps/bot run build && npm --workspace=apps/web run build",
    "test": "tsx --test packages/*/tests/*.ts apps/*/tests/*.ts",
    "check:slop": "node .agents/skills/oxfords/scripts/check.mjs apps/web/src",
    "db:generate": "npx --workspace=@solace/database prisma generate",
    "db:push": "npx --workspace=@solace/database prisma db push",
    "dev:bot": "npm --workspace=apps/bot run dev",
    "build:bot": "npm --workspace=apps/bot run build",
    "start:bot": "npm --workspace=apps/bot run start",
    "deploy:commands": "npm --workspace=apps/bot run deploy:commands",
    "dev:web": "npm --workspace=apps/web run dev",
    "build:web": "npm --workspace=apps/web run build",
    "start:web": "npm --workspace=apps/web run start"
  },
  "keywords": [
    "discord-bot",
    "music",
    "lavalink",
    "spotify",
    "youtube-music",
    "soundcloud"
  ],
  "author": "senu-io",
  "engines": {
    "node": ">=20.0.0"
  }
}
