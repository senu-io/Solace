# ==========================================
# SOLACE - ENVIRONMENT CONFIGURATION
# ==========================================

# Discord Bot Credentials
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Bot Owner & Admin Configuration
# Comma-separated Discord User IDs for superadmin access
BOT_OWNER_IDS=your_discord_user_id
BOT_ADMIN_IDS=

# Default Bot Settings
DEFAULT_PREFIX=!
DEFAULT_VOLUME=80

# Lavalink v4 Configuration
# Host & credentials for the Lavalink audio streaming node
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Spotify API Credentials (Required for Spotify link resolving via LavaSrc)
# Obtain from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Database Configuration (PostgreSQL - Used in Phase 3)
DATABASE_URL=postgresql://solace:solace_password@localhost:5432/solace?schema=public

# Redis Configuration (Used for cache and real-time dashboard sync)
REDIS_URL=redis://localhost:6379

# Web Dashboard Configuration (Used in Phase 4)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_32_character_string_here
